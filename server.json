{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.linkjolt/linkjolt",
  "title": "LinkJolt",
  "description": "For businesses that pay affiliates: set up and run your affiliate program from your AI assistant.",
  "version": "1.0.1",
  "websiteUrl": "https://www.linkjolt.io/developers/mcp",
  "repository": {
    "url": "https://github.com/Efesop/linkjolt-mcp-server",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://www.linkjolt.io/android-chrome-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.linkjolt.io/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@linkjolt/mcp-server",
      "version": "0.3.1",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "LINKJOLT_API_KEY",
          "description": "A LinkJolt API key from https://www.linkjolt.io/merchant/api-keys. Without it only the planning tools work.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
